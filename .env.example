# Скопируйте этот файл в .env (без .example) и впишите свои значения.
# Без кавычек и без пробелов вокруг знака «=».

# --- Токен бота из MasterBot (внутри мессенджера MAX) ---
MAX_BOT_TOKEN=токен_из_MasterBot

# --- Языковая модель. Вариант 1: OpenRouter ---
LLM_API_KEY=sk-or-...
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=google/gemma-4-31b-it:free

# --- Вариант 2: Yandex Cloud (закомментируйте блок OpenRouter выше и раскомментируйте этот) ---
# LLM_API_KEY=API-ключ_сервисного_аккаунта
# LLM_BASE_URL=https://llm.api.cloud.yandex.net/v1
# LLM_PROJECT=идентификатор_каталога
# LLM_MODEL=gpt://идентификатор_каталога/yandexgpt/latest

# --- Вариант 3: GigaChat (Сбер). Раскомментируйте этот блок и закомментируйте OpenRouter выше ---
# LLM_PROVIDER=gigachat
# GIGACHAT_CREDENTIALS=ключ_авторизации_из_личного_кабинета_GigaChat_API
# GIGACHAT_SCOPE=GIGACHAT_API_PERS
# GIGACHAT_MODEL=GigaChat-2
# Сертификат «Russian Trusted Root CA» с сайта Госуслуг (https://www.gosuslugi.ru/crt), укажите путь к файлу:
# GIGACHAT_CA_BUNDLE_FILE=C:/Users/daba/Desktop/Russian_Trusted_Root_CA.cer
# Только для проверки (небезопасно): вместо сертификата отключить проверку
# GIGACHAT_VERIFY_SSL_CERTS=false

# --- Необязательно ---
# Максимальная длина ответа модели в токенах (по умолчанию 2500)
# MAX_TOKENS=2500
# Режим «только по контексту» по умолчанию (дальше переключается в админке)
# STRICT_DOCS=1

# --- Веб-админка: http://localhost:8080 ---
ADMIN_PORT=8080
ADMIN_USER=admin
ADMIN_PASSWORD=придумайте_пароль
# ADMIN_HOST=0.0.0.0   # только если выкладываете на сервер; обязательно задайте пароль и HTTPS
